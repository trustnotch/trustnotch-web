---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonicalPath?: string;
}

const {
  title,
  description,
  ogImage = '/og-default.png',
  canonicalPath = Astro.url.pathname,
} = Astro.props;

const siteUrl = 'https://trustnotch.com';

// build.format is 'directory', so every page is SERVED at a trailing-slash URL
// and a no-slash request 308-redirects. Normalise here so canonical, og:url and
// twitter:* all name the URL that is actually served -- never one that redirects.
// This also keeps the canonicals in lockstep with @astrojs/sitemap, which emits
// the trailing-slash form.
const normalisedPath = canonicalPath.endsWith('/') ? canonicalPath : `${canonicalPath}/`;
const canonicalUrl = `${siteUrl}${normalisedPath}`;
const ogImageUrl = `${siteUrl}${ogImage}`;

const isHome = normalisedPath === '/';

const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${siteUrl}/#org`,
  name: 'TrustNotch',
  url: siteUrl,
  logo: `${siteUrl}/favicon.svg`,
  description:
    'EU-built, tamper-evident audit logging for AI agents: Ed25519-signed receipts, RFC 6962 Merkle batching, Bitcoin anchoring, and an independent offline verifier.',
  areaServed: 'EU',
  sameAs: [
    'https://github.com/trustnotch',
    'https://pypi.org/project/trustnotch/',
    'https://pypi.org/project/trustnotch-mcp/',
  ],
};

const appJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'TrustNotch',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Any',
  url: siteUrl,
  description:
    'TrustNotch is a tamper-evident audit log for AI agents. Every action returns a cryptographically signed receipt, is batched into an RFC 6962 Merkle tree, and is anchored to Bitcoin via OpenTimestamps, so any entry can be verified independently and offline, without trusting TrustNotch. Built and hosted in the EU, designed for EU AI Act Article 12 record-keeping.',
  featureList: [
    'Tamper-evident audit logs for AI agents',
    'Ed25519-signed receipts on submission',
    'RFC 6962 Merkle batching',
    'Bitcoin anchoring via OpenTimestamps',
    'Independent offline verification with an open-source verifier',
    'Model Context Protocol (MCP) support',
    'Autonomous machine sign-up and API keys',
    'EU-hosted, EU data residency',
  ],
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'EUR',
    description: 'Free tier: 10,000 entries per month, no card required. Paid plans available.',
    url: `${siteUrl}/pricing/`,
  },
  publisher: { '@id': `${siteUrl}/#org` },
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What is an AI audit log?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'A record of the actions and decisions an AI system takes, kept so you can review or prove them later. A tamper-evident audit log goes further: it is built so any change to a past entry can be detected.',
      },
    },
    {
      '@type': 'Question',
      name: 'What does tamper-evident mean?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'You cannot quietly alter a record after the fact. Every entry is signed and anchored to Bitcoin, so if a single character changes, verification fails and the change is obvious.',
      },
    },
    {
      '@type': 'Question',
      name: 'Do I need this for the EU AI Act?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'The EU AI Act requires providers of high-risk AI systems to keep automatic logs of what their systems do, under Article 12. Those obligations are being phased in over the next couple of years. TrustNotch gives you records designed to meet that kind of requirement. This is not legal advice, so check how the rules apply to your own system.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can I verify a record without trusting TrustNotch?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. The verifier is free and open-source. It checks the signature and the Bitcoin timestamp by itself, so it works even if TrustNotch is offline or gone.',
      },
    },
    {
      '@type': 'Question',
      name: 'How do my AI agents send their logs?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Over a simple HTTP API, or through the Model Context Protocol so agents can log actions directly. An agent can even create its own free account and API key without a human.',
      },
    },
    {
      '@type': 'Question',
      name: 'Where is my data stored?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'In the EU. TrustNotch is built and hosted on infrastructure in Helsinki, Finland, with no third-party trackers and no data leaving the region.',
      },
    },
    {
      '@type': 'Question',
      name: 'Is TrustNotch open-source?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'The verifier is open-source and published on PyPI and GitHub, so anyone can inspect exactly how verification works. The service that stores and anchors your logs is run by TrustNotch.',
      },
    },
    {
      '@type': 'Question',
      name: 'What does TrustNotch cost?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'There is a free tier to start, with paid plans as you grow. See the pricing page for current tiers.',
      },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="TrustNotch" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />

    {isHome && (
      <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
      <script type="application/ld+json" set:html={JSON.stringify(appJsonLd)} />
      <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
    )}
  </head>
  <body>
    <header class="site-header" role="banner">
      <div class="site-header__inner">
        <a href="/" class="site-header__wordmark" aria-label="TrustNotch home">
          <svg class="notch-mark" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <path fill-rule="evenodd" fill="#16181A" d="M1 0 H15 A1 1 0 0 1 16 1 V15 A1 1 0 0 1 15 16 H1 A1 1 0 0 1 0 15 V1 A1 1 0 0 1 1 0 Z M4 0 L12 0 L8 5 Z M4 8 H6 V13 H4 Z M7 8 H9 V13 H7 Z M10 8 H12 V13 H10 Z"/>
          </svg>
          TrustNotch
        </a>
        <div class="site-header__right">
          <nav class="site-header__nav" aria-label="Main navigation">
            <a href="/how-verification-works/">How it works</a>
            <a href="/why-it-matters/">Why it matters</a>
            <a href="/trustnotch-mcp/">MCP Server</a>
            <a href="/docs/">Docs</a>
            <a href="/pricing/">Pricing</a>
            <a href="/faq/">FAQ</a>
          </nav>
          <a href="https://app.trustnotch.com/login" class="site-header__cta">Sign in</a>
        </div>
      </div>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer" role="contentinfo">
      <div class="site-footer__inner">
        <span>&copy; {new Date().getFullYear()} TrustNotch &mdash; Built and hosted in the EU &mdash; Helsinki, Finland</span>
        <ul class="site-footer__links">
          <li><a href="https://pypi.org/project/trustnotch/" rel="noopener noreferrer">PyPI: trustnotch</a></li>
          <li><a href="https://pypi.org/project/trustnotch-mcp/" rel="noopener noreferrer">PyPI: trustnotch-mcp</a></li>
          <li><a href="https://github.com/trustnotch" rel="noopener noreferrer">GitHub</a></li>
          <li><a href="/pricing/">Pricing</a></li>
          <li><a href="/privacy/">Privacy</a></li>
        </ul>
      </div>
    </footer>
  </body>
</html>

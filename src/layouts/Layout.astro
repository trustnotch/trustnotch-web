---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonicalPath?: string;
}

const {
  title,
  description,
  ogImage = '/og-default.png',
  canonicalPath = Astro.url.pathname,
} = Astro.props;

const siteUrl = 'https://trustnotch.com';

// build.format is 'directory', so every page is SERVED at a trailing-slash URL
// and a no-slash request 308-redirects. Normalise here so canonical, og:url and
// twitter:* all name the URL that is actually served -- never one that redirects.
// This also keeps the canonicals in lockstep with @astrojs/sitemap, which emits
// the trailing-slash form.
const normalisedPath = canonicalPath.endsWith('/') ? canonicalPath : `${canonicalPath}/`;
const canonicalUrl = `${siteUrl}${normalisedPath}`;
const ogImageUrl = `${siteUrl}${ogImage}`;

const isHome = normalisedPath === '/';

const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'TrustNotch',
  url: siteUrl,
  logo: `${siteUrl}/favicon.svg`,
  description:
    'Tamper-evident audit logs for AI agents: Ed25519-signed receipts, RFC 6962 Merkle batching, Bitcoin anchoring, and an independent offline verifier.',
};

const appJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'TrustNotch',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Any',
  url: siteUrl,
  description:
    'An audit-log service for AI agents. Every entry returns a cryptographically signed receipt, is batched into an RFC 6962 Merkle tree, and is anchored to Bitcoin. Any entry can be verified offline by an independent verifier.',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'EUR',
    description: 'Free tier: 10,000 entries per month, no card required.',
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="TrustNotch" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />

    {isHome && (
      <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
      <script type="application/ld+json" set:html={JSON.stringify(appJsonLd)} />
    )}
  </head>
  <body>
    <header class="site-header" role="banner">
      <div class="site-header__inner">
        <a href="/" class="site-header__wordmark" aria-label="TrustNotch home">
          <svg class="notch-mark" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <path fill-rule="evenodd" fill="#16181A" d="M1 0 H15 A1 1 0 0 1 16 1 V15 A1 1 0 0 1 15 16 H1 A1 1 0 0 1 0 15 V1 A1 1 0 0 1 1 0 Z M4 0 L12 0 L8 5 Z M4 8 H6 V13 H4 Z M7 8 H9 V13 H7 Z M10 8 H12 V13 H10 Z"/>
          </svg>
          TrustNotch
        </a>
        <div class="site-header__right">
          <nav class="site-header__nav" aria-label="Main navigation">
            <a href="/how-verification-works/">How it works</a>
            <a href="/why-it-matters/">Why it matters</a>
            <a href="/trustnotch-mcp/">MCP Server</a>
            <a href="/pricing/">Pricing</a>
            <a href="/faq/">FAQ</a>
          </nav>
          <a href="https://app.trustnotch.com/login" class="site-header__cta">Sign in</a>
        </div>
      </div>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer" role="contentinfo">
      <div class="site-footer__inner">
        <span>&copy; {new Date().getFullYear()} TrustNotch &mdash; Built and hosted in the EU &mdash; Helsinki, Finland</span>
        <ul class="site-footer__links">
          <li><a href="https://pypi.org/project/trustnotch/" rel="noopener noreferrer">PyPI: trustnotch</a></li>
          <li><a href="https://pypi.org/project/trustnotch-mcp/" rel="noopener noreferrer">PyPI: trustnotch-mcp</a></li>
          <li><a href="https://github.com/trustnotch" rel="noopener noreferrer">GitHub</a></li>
          <li><a href="/pricing/">Pricing</a></li>
          <li><a href="/privacy/">Privacy</a></li>
        </ul>
      </div>
    </footer>
  </body>
</html>
